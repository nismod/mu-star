@online{molnarCommunityDetectionDirected2023,
  title = {Community {{Detection}} in {{Directed Weighted Networks}} Using {{Voronoi Partitioning}}},
  author = {Molnár, Botond and Márton, Ildikó-Beáta and Horvát, Szabolcs and Ercsey-Ravasz, Mária},
  date = {2023-04-24},
  url = {https://arxiv.org/abs/2304.12389v1},
  urldate = {2024-03-04},
  abstract = {Community detection is a ubiquitous problem in applied network analysis, yet efficient techniques do not yet exist for all types of network data. Most techniques have been developed for undirected graphs, and very few exist that handle directed and weighted networks effectively. Here we present such an algorithm based on Voronoi partitionings. As an added benefit, this method can directly employ edge weights that represent lengths, in contrast to algorithms that operate with connection strengths, requiring ad-hoc transformations of length data. We demonstrate the method on inter-areal brain connectivity, air transportation networks, as well as on randomly generated benchmark networks. The algorithm can handle dense graphs where weights are the main factor determining communities. The hierarchical structure of networks can also be detected, as shown for the brain. Its time efficiency is comparable with other state-of-the-art algorithms, the most costly part being Dijkstra's shortest paths algorithm.},
  langid = {english},
  organization = {arXiv.org},
  file = {/Users/cenv1069/Zotero/storage/98PCWQHW/2304.12389v1.pdf}
}


@article{erwigGraphVoronoiDiagram2000,
  title = {The Graph {{Voronoi}} Diagram with Applications},
  author = {Erwig, Martin},
  date = {2000},
  journaltitle = {Networks},
  volume = {36},
  number = {3},
  pages = {156--163},
  issn = {1097-0037},
  doi = {10.1002/1097-0037(200010)36:3<156::AID-NET2>3.0.CO;2-L},
  url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/1097-0037%28200010%2936%3A3%3C156%3A%3AAID-NET2%3E3.0.CO%3B2-L},
  urldate = {2024-02-14},
  abstract = {The Voronoi diagram is a famous structure of computational geometry. We show that there is a straightforward equivalent in graph theory which can be efficiently computed. In particular, we give two algorithms for the computation of graph Voronoi diagrams, prove a lower bound on the problem, and identify cases where the algorithms presented are optimal. The space requirement of a graph Voronoi diagram is modest, since it needs no more space than does the graph itself. The investigation of graph Voronoi diagrams is motivated by many applications and problems on networks that can be easily solved with their help. This includes the computation of nearest facilities, all nearest neighbors and closest pairs, some kind of collision free moving, and anticenters and closest points. © 2000 John Wiley \& Sons, Inc.},
  langid = {english},
  keywords = {Dijkstra's algorithm,shortest path,Voronoi diagram},
  file = {/Users/cenv1069/Zotero/storage/V95S3WGP/Erwig - 2000 - The graph Voronoi diagram with applications.pdf;/Users/cenv1069/Zotero/storage/MTPWD6N4/1097-0037(200010)363156AID-NET23.0.html}
}
